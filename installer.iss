; Script generated by Inno Setup
; Caffeine for Windows installer

#define MyAppName "Caffeine for Windows"
#define MyAppVersion "0.2.0"
#define MyAppPublisher "Abdul Karim Mia"
#define MyAppURL "https://github.com/abdul-karim-mia/caffeine-win"
#define MyAppExecutable "caffeine-win.exe"

[Setup]
AppId={{D8F7E9A0-C1B2-4A3F-8C5D-1E2F3A4B5C6D}}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
DefaultDirName={autopf}\{#MyAppName}
DisableProgramGroupPage=no
PrivilegesRequired=lowest
LicenseFile=LICENSE
Compression=lzma
SolidCompression=yes
WizardStyle=modern
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
OutputDir=dist
OutputBaseFilename=caffeine-win-setup

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "autostart"; Description: "Start {#MyAppName} with Windows"; Flags: unchecked

[Files]
Source: "target\release\{#MyAppExecutable}"; DestDir: "{app}"; Flags: ignoreversion
Source: "README.md"; DestDir: "{app}"; Flags: ignoreversion

[Icons]
Name: "{autostartmenu}\Programs\{#MyAppName}.lnk"; Filename: "{app}\{#MyAppExecutable}"; WorkingDir: "{autopf}"; Tasks: autostart
Name: "{autodesktop}\{#MyAppName}.lnk"; Filename: "{app}\{#MyAppExecutable}"; WorkingDir: "{autopf}"

[Run]
Filename: "{app}\{#MyAppExecutable}"; Description: "Launch {#MyAppName}"; Flags: nowait postinstall skipifsilent; Check: not WizardIsTaskSelected('autostart')

[Registry]
Root: HKCU; Subkey: "Software\Microsoft\Windows\CurrentVersion\Run"; ValueType: string; ValueName: "{#MyAppName}"; ValueData: "{app}\{#MyAppExecutable}"; Flags: uninsdeletevalue; Tasks: autostart

[UninstallDelete]
Type: filesandordirs; Name: "{app}\*"
